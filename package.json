{
  "name": "wrap-guide",
  "author": "lumine-code",
  "version": "1.0.0",
  "description": "Displays a vertical line in the editor to guide line length.",
  "keywords": [
    "ruler",
    "column",
    "line-length",
    "margin"
  ],
  "repository": "https://github.com/lumine-code/wrap-guide",
  "bugs": {
    "url": "https://github.com/lumine-code/wrap-guide/issues"
  },
  "license": "MIT",
  "main": "./lib/main",
  "files": [
    "lib",
    "spec",
    "styles",
    "THIRD_PARTY_NOTICES"
  ],
  "engines": {
    "lumine": "^1.0.0"
  },
  "providedServices": {
    "background-tips.provider": {
      "versions": {
        "1.0.0": "provideBackgroundTips"
      }
    }
  },
  "specPackages": [
    "language-coffee-script"
  ],
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "configSchema": {
    "enabled": {
      "title": "Enabled",
      "description": "Show the wrap guide in editors.",
      "scopeResolution": "grammar",
      "type": "boolean",
      "default": true
    },
    "showWrapGuide": {
      "title": "Show Wrap Guide",
      "description": "Show the editor's preferred line length, optionally only while wrapping, or follow the editor's actual soft wrap column.",
      "type": "string",
      "enum": [
        {
          "value": "always",
          "description": "Always"
        },
        {
          "value": "wrapping",
          "description": "When soft wrap is enabled"
        },
        {
          "value": "atSoftWrapColumn",
          "description": "At the soft wrap column when wrapping is enabled"
        }
      ],
      "default": "always"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.5.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1"
  },
  "overrides": {
    "eslint@^10.14.0": {
      "minimatch": "11.0.8"
    },
    "@eslint/config-array@0.23.5": {
      "minimatch": "11.0.8"
    }
  }
}
